# Contact form endpoint. Any service that accepts a POST of form fields works;
# Formspree is the usual choice for a static site with no backend.
#
#   1. Sign up at https://formspree.io (free tier is fine)
#   2. Create a form, point it at your own email address
#   3. Copy the endpoint it gives you and paste it below
#
# Leave this unset and the form falls back to opening the visitor's mail
# client with the message pre-filled — nothing is lost either way.
#
# The PUBLIC_ prefix is required: Astro only exposes prefixed variables to
# client-side code, which is where the form submits from.
PUBLIC_CONTACT_ENDPOINT=https://formspree.io/f/xxxxxxxx
