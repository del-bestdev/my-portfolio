---
/**
 * Schematic architecture diagram used as a project card header.
 *
 * These are original illustrations of the system each project describes —
 * deliberately not screenshots. The work is internal and under NDA, so there
 * is nothing public to photograph, and borrowing an employer's marketing site
 * would misrepresent what was actually built.
 *
 * Drawn as inline SVG so they stay crisp at any size, cost no extra request,
 * and inherit the page's palette.
 */
let instances = 0;
const nextId = () => ++instances;

interface Props {
  kind: string;
  class?: string;
}

const { kind, class: className = "" } = Astro.props;

// SVG element ids must be unique within a document, and a card can appear
// more than once per page, so each instance gets its own suffix.
const uid = `pv-${kind}-${nextId()}`;

const TEAL = "#06b6d4";
const PURPLE = "#9333ea";
const MUTED = "#64748b";
const LABEL = "#cbd5e1";

/** One-line description announced to screen readers. */
const TITLES: Record<string, string> = {
  rag: "Diagram: documents flow through embedding into a vector database, then to a language model.",
  microservices: "Diagram: a monolith decomposed into independently deployable services.",
  portal: "Diagram: page load time reduced from 3.8 seconds to 1.1 seconds.",
  guardrails: "Diagram: requests pass through a guardrail and semantic cache before reaching the model.",
  telemetry: "Diagram: a real-time event stream with an anomaly detected.",
  kafka: "Diagram: a producer writing into partitioned Kafka topics consumed downstream.",
};
---

<svg
  viewBox="0 0 400 160"
  class={`w-full h-auto ${className}`}
  role="img"
  aria-label={TITLES[kind] ?? "Architecture diagram"}
  preserveAspectRatio="xMidYMid meet"
>
  <defs>
    <linearGradient id={`${uid}-g`} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color={PURPLE}></stop>
      <stop offset="1" stop-color={TEAL}></stop>
    </linearGradient>
    <marker
      id={`${uid}-a`}
      viewBox="0 0 10 10"
      refX="8"
      refY="5"
      markerWidth="5"
      markerHeight="5"
      orient="auto-start-reverse"
    >
      <path d="M0 0 L10 5 L0 10 z" fill={TEAL}></path>
    </marker>
    <pattern id={`${uid}-grid`} width="20" height="20" patternUnits="userSpaceOnUse">
      <path d="M20 0 L0 0 0 20" fill="none" stroke={MUTED} stroke-width="0.5" opacity="0.25"
      ></path>
    </pattern>
  </defs>

  <rect width="400" height="160" fill={`url(#${uid}-grid)`}></rect>

  {
    kind === "rag" && (
      <g>
        <g stroke={TEAL} stroke-width="1.5" marker-end={`url(#${uid}-a)`} opacity="0.8">
          <line x1="118" y1="80" x2="150" y2="80" />
          <line x1="244" y1="80" x2="276" y2="80" />
        </g>
        {/* documents */}
        <g>
          <rect x="30" y="52" width="88" height="56" rx="6" fill="none" stroke={MUTED} stroke-width="1.5" />
          <g fill={MUTED} opacity="0.55">
            <rect x="44" y="66" width="60" height="4" rx="2" />
            <rect x="44" y="76" width="60" height="4" rx="2" />
            <rect x="44" y="86" width="38" height="4" rx="2" />
          </g>
          <text x="74" y="126" fill={LABEL} font-size="11" font-family="monospace" text-anchor="middle">
            Documents
          </text>
        </g>
        {/* vector store */}
        <g>
          <rect x="156" y="52" width="88" height="56" rx="6" fill="none" stroke={TEAL} stroke-width="1.5" />
          <g fill={TEAL}>
            <circle cx="176" cy="70" r="3" /><circle cx="192" cy="80" r="3" />
            <circle cx="208" cy="66" r="3" /><circle cx="224" cy="78" r="3" />
            <circle cx="186" cy="94" r="3" /><circle cx="214" cy="92" r="3" />
          </g>
          <text x="200" y="126" fill={LABEL} font-size="11" font-family="monospace" text-anchor="middle">
            Vector DB
          </text>
        </g>
        {/* model */}
        <g>
          <rect x="282" y="52" width="88" height="56" rx="6" fill={`url(#${uid}-g)`} opacity="0.18" />
          <rect x="282" y="52" width="88" height="56" rx="6" fill="none" stroke={PURPLE} stroke-width="1.5" />
          <text x="326" y="86" fill="#fff" font-size="15" font-family="monospace" text-anchor="middle">
            LLM
          </text>
          <text x="326" y="126" fill={LABEL} font-size="11" font-family="monospace" text-anchor="middle">
            Generation
          </text>
        </g>
        <text x="200" y="30" fill={TEAL} font-size="10" font-family="monospace" text-anchor="middle" opacity="0.85">
          retrieval-augmented pipeline
        </text>
      </g>
    )
  }

  {
    kind === "microservices" && (
      <g>
        {/* monolith */}
        <rect x="26" y="40" width="96" height="80" rx="6" fill={MUTED} opacity="0.18" />
        <rect x="26" y="40" width="96" height="80" rx="6" fill="none" stroke={MUTED} stroke-width="1.5" />
        <text x="74" y="86" fill={LABEL} font-size="11" font-family="monospace" text-anchor="middle">
          monolith
        </text>
        {/* split arrow */}
        <line
          x1="134" y1="80" x2="176" y2="80"
          stroke={TEAL} stroke-width="1.5" marker-end={`url(#${uid}-a)`}
        />
        {/* services */}
        <g>
          {[0, 1, 2, 3, 4, 5].map((i) => {
            const col = i % 3;
            const row = Math.floor(i / 3);
            return (
              <g>
                <rect
                  x={192 + col * 68} y={44 + row * 44} width="58" height="34" rx="5"
                  fill={TEAL} opacity="0.12"
                />
                <rect
                  x={192 + col * 68} y={44 + row * 44} width="58" height="34" rx="5"
                  fill="none" stroke={TEAL} stroke-width="1.3"
                />
                <circle cx={192 + col * 68 + 29} cy={44 + row * 44 + 17} r="3.5" fill={TEAL} />
              </g>
            );
          })}
        </g>
        <text x="279" y="146" fill={LABEL} font-size="11" font-family="monospace" text-anchor="middle">
          independently deployable services
        </text>
      </g>
    )
  }

  {
    kind === "portal" && (
      <g>
        {/* browser chrome */}
        <rect x="26" y="26" width="348" height="108" rx="8" fill="none" stroke={MUTED} stroke-width="1.5" />
        <line x1="26" y1="48" x2="374" y2="48" stroke={MUTED} stroke-width="1.5" />
        <g fill={MUTED} opacity="0.8">
          <circle cx="42" cy="37" r="3.5" /><circle cx="54" cy="37" r="3.5" /><circle cx="66" cy="37" r="3.5" />
        </g>
        {/* before */}
        <text x="46" y="74" fill={MUTED} font-size="10" font-family="monospace">before</text>
        <rect x="96" y="66" width="232" height="10" rx="5" fill={MUTED} opacity="0.45" />
        <text x="338" y="75" fill={MUTED} font-size="11" font-family="monospace">3.8s</text>
        {/* after */}
        <text x="46" y="108" fill={TEAL} font-size="10" font-family="monospace">after</text>
        <rect x="96" y="100" width="68" height="10" rx="5" fill={`url(#${uid}-g)`} />
        <text x="338" y="109" fill={TEAL} font-size="11" font-family="monospace">1.1s</text>
        <line
          x1="170" y1="105" x2="320" y2="105"
          stroke={TEAL} stroke-width="1.2" stroke-dasharray="3 4" opacity="0.6"
        />
      </g>
    )
  }

  {
    kind === "guardrails" && (
      <g>
        <line x1="24" y1="68" x2="78" y2="68" stroke={TEAL} stroke-width="1.5" marker-end={`url(#${uid}-a)`} />
        {/* shield */}
        <path
          d="M128 34 L162 46 C162 76 148 92 128 100 C108 92 94 76 94 46 Z"
          fill={PURPLE} opacity="0.18"
        />
        <path
          d="M128 34 L162 46 C162 76 148 92 128 100 C108 92 94 76 94 46 Z"
          fill="none" stroke={PURPLE} stroke-width="1.6"
        />
        <path d="M116 64 L125 73 L142 55" fill="none" stroke={TEAL} stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
        <text x="128" y="120" fill={LABEL} font-size="10" font-family="monospace" text-anchor="middle">
          guardrail
        </text>
        <line x1="170" y1="68" x2="214" y2="68" stroke={TEAL} stroke-width="1.5" marker-end={`url(#${uid}-a)`} />
        {/* model */}
        <rect x="222" y="44" width="92" height="48" rx="6" fill={`url(#${uid}-g)`} opacity="0.18" />
        <rect x="222" y="44" width="92" height="48" rx="6" fill="none" stroke={TEAL} stroke-width="1.5" />
        <text x="268" y="74" fill="#fff" font-size="13" font-family="monospace" text-anchor="middle">model</text>
        <line x1="322" y1="68" x2="376" y2="68" stroke={TEAL} stroke-width="1.5" marker-end={`url(#${uid}-a)`} />
        {/* cache */}
        <rect x="94" y="126" width="220" height="24" rx="5" fill={TEAL} opacity="0.1" />
        <rect x="94" y="126" width="220" height="24" rx="5" fill="none" stroke={TEAL} stroke-width="1.2" stroke-dasharray="4 4" />
        <text x="204" y="142" fill={TEAL} font-size="10" font-family="monospace" text-anchor="middle">
          semantic cache
        </text>
      </g>
    )
  }

  {
    kind === "telemetry" && (
      <g>
        <line x1="26" y1="124" x2="374" y2="124" stroke={MUTED} stroke-width="1.2" opacity="0.6" />
        <polyline
          points="30,104 62,88 94,96 126,62 158,78 190,52 222,70 254,40 286,66 318,50 350,74 374,60"
          fill="none" stroke={`url(#${uid}-g)`} stroke-width="2.2"
          stroke-linecap="round" stroke-linejoin="round"
        />
        <g fill={TEAL}>
          <circle cx="94" cy="96" r="3" /><circle cx="190" cy="52" r="3" /><circle cx="318" cy="50" r="3" />
        </g>
        {/* anomaly */}
        <circle cx="254" cy="40" r="7" fill="none" stroke="#f87171" stroke-width="1.6" />
        <circle cx="254" cy="40" r="3" fill="#f87171" />
        <text x="254" y="26" fill="#f87171" font-size="9" font-family="monospace" text-anchor="middle">
          anomaly
        </text>
        <text x="30" y="144" fill={LABEL} font-size="10" font-family="monospace">
          4.5M+ events / day
        </text>
      </g>
    )
  }

  {
    kind === "kafka" && (
      <g>
        {/* producer */}
        <rect x="22" y="58" width="58" height="44" rx="5" fill={PURPLE} opacity="0.16" />
        <rect x="22" y="58" width="58" height="44" rx="5" fill="none" stroke={PURPLE} stroke-width="1.4" />
        <text x="51" y="84" fill={LABEL} font-size="9" font-family="monospace" text-anchor="middle">producer</text>
        {/* partitions */}
        {[0, 1, 2].map((row) => (
          <g>
            <line
              x1="86" y1={44 + row * 36} x2="300" y2={44 + row * 36}
              stroke={MUTED} stroke-width="0.8" opacity="0.4"
            />
            {[0, 1, 2, 3, 4].map((seg) => (
              <rect
                x={96 + seg * 40} y={34 + row * 36} width="32" height="20" rx="3"
                fill={TEAL} opacity={0.5 - seg * 0.07}
              />
            ))}
            <text x="90" y={48 + row * 36} fill={MUTED} font-size="8" font-family="monospace" text-anchor="end">
              p{row}
            </text>
          </g>
        ))}
        {/* consumers */}
        <line x1="306" y1="70" x2="334" y2="70" stroke={TEAL} stroke-width="1.4" marker-end={`url(#${uid}-a)`} />
        <rect x="340" y="40" width="46" height="28" rx="4" fill="none" stroke={TEAL} stroke-width="1.3" />
        <rect x="340" y="80" width="46" height="28" rx="4" fill="none" stroke={TEAL} stroke-width="1.3" />
        <line x1="306" y1="70" x2="334" y2="94" stroke={TEAL} stroke-width="1.4" marker-end={`url(#${uid}-a)`} />
        <text x="200" y="150" fill={LABEL} font-size="10" font-family="monospace" text-anchor="middle">
          partitioned event log
        </text>
      </g>
    )
  }
</svg>
