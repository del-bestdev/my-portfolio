interface Props {
  name: string;
  class?: string;
  /** Pass a title only for a standalone, meaningful icon; decorative icons stay aria-hidden. */
  title?: string;
}

const { name, class: className = "", title } = Astro.props;
const body = icons[name];

if (!body) {
  throw new Error(
    `<Icon /> got an unknown name: "${name}". Known icons: ${Object.keys(icons).join(", ")}`
  );
}
---

<svg
  width="1em"
  height="1em"
  viewBox="0 0 16 16"
  fill="currentColor"
  class={className}
  role={title ? "img" : undefined}
  aria-hidden={title ? undefined : "true"}
  set:html={(title ? `<title>${title}</title>` : "") + body}
/>
