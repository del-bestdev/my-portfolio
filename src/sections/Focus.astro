---
import Icon from "../components/Icon.astro";
import GradientCard from "../components/GradientCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { focus } from "../data/site";
---

<section id="focus" class="py-20 relative overflow-hidden">
  <div
    class="absolute top-0 right-1/4 w-72 h-72 rounded-full bg-tech-teal opacity-10 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="max-w-7xl mx-auto px-4 lg:px-8 relative z-10">
    <SectionHeading lead="Current Engineering" accent="Focus" subtitle={focus.blurb} />

    <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 reveal">
      {
        focus.items.map((item, i) => (
          <GradientCard as="li">
            <div class="flex items-start gap-4">
              <Icon name={item.icon} class="text-tech-teal text-3xl flex-shrink-0 mt-0.5" />
              <div>
                <p class="font-mono text-xs text-tech-purple mb-1">
                  {String(i + 1).padStart(2, "0")}
                </p>
                <h3 class="text-lg font-semibold mb-2">{item.title}</h3>
                <p class="text-gray-400 text-sm leading-relaxed">{item.body}</p>
              </div>
            </div>
          </GradientCard>
        ))
      }
    </ul>
  </div>
</section>
